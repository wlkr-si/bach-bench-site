---
import BackLink from '../../../components/BackLink.astro';
import Button from '../../../components/Button.astro';
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import FieldScores from '../../../components/analytics/FieldScores.astro';
import Score from '../../../components/analytics/Score.astro';
import { pieceValues, metrics, format, provenance } from '../../../lib/results';
import '../../../styles/analytics.css';

const entry = Astro.locals.piece!;
const detail = Astro.locals.detail!;
const piece = { ...entry, values: pieceValues(entry), run: detail.measurements, analysis: detail.analysis };
const field = Astro.locals.vault.pieces.map(({ slug, modelName, title, measurements }) => ({
  id: slug, model: modelName, title, wall: measurements.wall, lines: measurements.lines,
  level: measurements.loudness, frames: measurements.frames,
}));
const sleeve = {
  field,
  piece: { ...field.find(({ id }) => id === entry.slug)!, env: detail.timeline.env, colors: detail.timeline.colors },
};
const headline: (typeof metrics)[number][] = [
  metrics[0],
  metrics[1],
  metrics[5],
];
const runFields = [
  ['Tool', 'tool'],
  ['Tool version', 'toolVersion'],
  ['Reported model', 'reportedModelId'],
  ['Tool duration (s)', 'toolReportedDurationSeconds'],
  ['Input tokens', 'inputTokens'],
  ['Output tokens', 'outputTokens'],
  ['Reasoning tokens', 'reasoningTokens'],
  ['Cached read tokens', 'cachedReadTokens'],
  ['Cached write tokens', 'cachedWriteTokens'],
  ['Reported cost (USD)', 'reportedCostUsd'],
];
---

<Layout
  title={`${piece.title} · ${piece.modelName} · Bach Bench`}
  poster={piece.posterUrl}
>
  <SiteHeader />
  <main class="measurements">
    <div class="toolbar">
      <BackLink href={`/p/${piece.slug}`}>{piece.title}</BackLink>
      <Button
        variant="solid"
        icon="download"
        class="save-sleeve"
        href="#sleeve"
        download={`bach-bench-${piece.slug}.png`}>Save card</Button
      >
    </div>
    <h1 class="sr-only">{piece.title} · {piece.modelName}</h1>
    <img
      class="sleeve"
      id="sleeve"
      width="1080"
      height="1350"
      alt={`Sound waveform and measured figures for ${piece.title} by ${piece.modelName}`}
    />
    <FieldScores piece={entry} score={detail.scores} />
    <Score derived={detail.timeline} />
    <dl class="tiles tiles--figures">
      {
        headline.map(({ key, label, unit }) => (
          <div class="tile">
            <dt class="tile-label">{label}</dt>
            <dd class="tile-value">
              {format(piece.values[key])}
              {piece.values[key] != null && unit && <small>{unit}</small>}
              {key === 'wall' && provenance(piece.run.wallSeconds) && (
                <small class="tile-note">
                  {provenance(piece.run.wallSeconds)}
                </small>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
    <section>
      <h2>Measurements</h2>
      {
        piece.run.route?.value === 'Pasted by hand' && (
          <dl class="credits">
            <div>
              <dt>Route</dt>
              <dd>
                Pasted by hand from {piece.run.chatSource?.value}. The chat page
                or app supplied its own hidden instructions.
              </dd>
            </div>
          </dl>
        )
      }
      <dl class="credits">
        {
          metrics
            .filter((metric) => !headline.includes(metric))
            .map(({ key, label, unit }) => (
              <div>
                <>
                  <dt>{label}</dt>
                  <dd class:list={[{ dash: piece.values[key] == null }]}>
                    {format(piece.values[key])}
                    {piece.values[key] != null && unit && ' ' + unit}
                  </dd>
                </>
              </div>
            ))
        }
        <div>
          <dt>Drawing</dt><dd>
            {piece.analysis?.drawingMethods?.join(', ') || '—'}
          </dd>
        </div>
        <div>
          <dt>Audio nodes</dt><dd>
            {
              Object.entries(piece.analysis?.audioNodeCallSites ?? {})
                .map(([name, count]) => `${name} × ${count}`)
                .join(', ') || '—'
            }
          </dd>
        </div>
        {
          runFields.map(([label, key]) => (
            <div>
              <>
                <dt>{label}</dt>
                <dd class:list={[{ dash: piece.run[key]?.value == null }]}>
                  {format(piece.run[key]?.value)}
                  {provenance(piece.run[key])}
                </dd>
              </>
            </div>
          ))
        }
      </dl>
    </section>
    <footer>
      <a href={detail.moduleUrl}>Module source</a>
      <a href={detail.replyUrl}>Full reply</a>
    </footer>
    <script
      is:inline
      type="application/json"
      id="sleeve-data"
      set:html={JSON.stringify(sleeve).replace(/</g, '\\u003c')}
    />
  </main>
</Layout>

<script>
  import { renderSleeve } from '../../../lib/sleeve.mjs';

  const img = document.querySelector<HTMLImageElement>('#sleeve')!;
  const link = document.querySelector<HTMLAnchorElement>('.save-sleeve')!;
  const payload = JSON.parse(document.querySelector('#sleeve-data')!.textContent!);

  const card = Promise.all([
    document.fonts.load('600 128px Geist'),
    document.fonts.load('500 40px Geist'),
    document.fonts.load('400 28px Geist'),
  ]).then(() => {
    const image = 'data:image/png;base64,' + renderSleeve(payload);
    img.src = image;
    link.href = image;
  }).catch((error) => {
    console.error('Could not draw the Piece card', error);
  });

  link.addEventListener('click', async (event) => {
    if (link.href.startsWith('data:')) return;
    event.preventDefault();
    await card;
    if (link.href.startsWith('data:')) link.click();
  });
</script>
