---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Button from '../components/Button.astro';
---

<Layout title="Not found · Bach Bench">
  <SiteHeader />
  <main class="missing">
    <h1>This page doesn’t exist.</h1>
    <div class="actions">
      <Button variant="solid" href="/listen" icon="play">Listen</Button>
      <Button href="/gallery">Gallery</Button>
    </div>
  </main>
</Layout>

<style>
  .missing {
    max-width: 800px;
    margin: 0 auto;
    padding: clamp(48px, 12vw, 140px) var(--gutter) 96px;
  }
  h1 {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.045em;
  }
  .actions {
    display: flex;
    gap: 8px;
    margin-top: 28px;
  }
</style>
