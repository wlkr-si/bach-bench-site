---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BackLink from '../components/BackLink.astro';
import { Content } from '../components/Method.md';
import instruction from '../components/instruction.md?raw';

const instructionExcerpt = instruction.replace(/^You are being benchmarked\. This is Bach Bench:[^.]+\. /, '');
---

<Layout title="Method · Bach Bench">
  <SiteHeader />
  <main class="method">
    <BackLink href="/analysis">Analysis</BackLink>
    <Content />
    <section id="instruction">
      <h2>Instruction</h2>
      <p>Excerpt from the Instruction each model received.</p>
      <blockquote>
        {instructionExcerpt.trim().split(/\n\s*\n/).map((part) => <p>{part}</p>)}
      </blockquote>
    </section>
  </main>
</Layout>

<style>
  .method {
    max-width: 800px;
    margin: 0 auto;
    padding: 24px 20px 80px;
    line-height: 1.6;
  }
  .method :global(h1) {
    margin-top: 16px;
    font-size: clamp(32px, 5vw, 44px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .method :global(h2) {
    margin-top: 2.5rem;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .method :global(p) {
    margin: 1rem 0;
  }
  .method :global(table) {
    width: 100%;
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }
  .method :global(td),
  .method :global(th) {
    padding: 0.5rem;
    border-bottom: 1px solid #343434;
    text-align: left;
  }
  blockquote {
    margin: 1rem 0 0;
    padding: 0 0 0 20px;
    color: var(--muted);
  }
  .method :global(a:not(.back)) {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--line-strong);
  }
</style>
