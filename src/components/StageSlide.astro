---
import ClipActions from './clip/ClipActions.astro';
import Icon from './Icon.astro';

interface Props {
  piece: { slug: string; title: string; modelName: string; clipUrl: string; posterUrl: string };
  index: number;
  total: number;
  cors: boolean;
  first?: boolean;
}

const { piece, index, total, cors, first = false } = Astro.props;
const count = (number: number) => String(number).padStart(2, '0');
---

<section class="st-slide" aria-label={piece.title} data-index={index}>
  <div class="st-frame">
    <div class="st-media">
      <img
        class="st-poster"
        src={piece.posterUrl || undefined}
        crossorigin={cors ? 'anonymous' : undefined}
        fetchpriority={first ? 'high' : undefined}
        width="1080"
        height="1350"
        alt=""
      />
      {first && <video preload="auto" playsinline aria-hidden="true" data-clip={piece.clipUrl} />}
      <button
        class="st-toggle"
        type="button"
        tabindex="-1"
        aria-hidden="true"></button>
    </div>
    <div class="st-prog" aria-hidden="true">
      <i />
    </div>
  </div>
  <div class="st-details">
    <div class:list={['st-meta', { enter: first }]}>
      <p class="st-model">{piece.modelName}</p>
      <h2 class="st-title">{piece.title}</h2>
    </div>
    <div class="st-controls">
      <div class="st-actions">
        <button
          class="st-play"
          type="button"
          data-play
          disabled={first}
          aria-label={`Play ${piece.title}`}
        >
          <span class="st-icon st-icon--play"><Icon name="play" /></span>
          <span class="st-icon st-icon--pause"><Icon name="pause" /></span>
          <span class="st-icon st-icon--wait" aria-hidden="true"></span>
          <span class="st-word st-word--play">Play</span>
          <span class="st-word st-word--pause">Pause</span>
          <span class="st-word st-word--wait">Loading</span>
          <span class="st-word st-word--blocked">Tap to play</span>
          <span class="st-word st-word--error">Retry</span>
        </button>
      </div>
      <div class="st-dock">
        <span class="st-count">
          {count(index + 1)} / {count(total)}
        </span>
        {total > 1 && (
          <nav class="st-nav" aria-label="Pieces">
            <button
              class="icon-button"
              type="button"
              data-step="-1"
              aria-label="Previous Piece"
              disabled={index === 0}
            >
              <Icon name="up" />
            </button>
            <button
              class="icon-button"
              type="button"
              data-step="1"
              aria-label="Next Piece"
              disabled={index === total - 1}
            >
              <Icon name="down" />
            </button>
          </nav>
        )}
      </div>
    </div>
    <div class="st-more">
      <ClipActions piece={piece} />
    </div>
  </div>
</section>
