---
import { vaultMediaAllowsCors } from '../lib/clip-buffer';
import SiteHeader from './SiteHeader.astro';
import StageSlide from './StageSlide.astro';
import { pieceAddress } from '../lib/share';

const { initial = 0 } = Astro.props;
const { pieces } = Astro.locals.vault;
const first = pieces[initial];
const total = pieces.length;
const cors = vaultMediaAllowsCors(Astro.url.origin);
const placeholder = { slug: '', title: '', modelName: '', clipUrl: '', posterUrl: '' };
const slides = pieces.map(({ title, modelName, slug, clipUrl, posterUrl }) => ({
  title, modelName, slug, clipUrl, posterUrl, address: pieceAddress(slug),
}));
---

<div class="st-layout">
  <SiteHeader current="stage" />
  <main class="st" data-stage data-initial={initial} data-cors={cors ? 'true' : undefined}>
    {first ? <StageSlide piece={first} index={initial} total={total} cors={cors} first /> :
      <p class="st-empty">No Pieces available.</p>}
  </main>
</div>
{first && <>
  <template id="stage-slide">
    <StageSlide piece={placeholder} index={-1} total={total} cors={cors} />
  </template>
  <script is:inline type="application/json" id="stage-catalogue" set:html={JSON.stringify(slides).replace(/</g, '\\u003c')} />
</>}
<script>
  import '../lib/stage';
</script>
