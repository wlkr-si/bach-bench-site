---
import Icon from '../Icon.astro';
import { pieceAddress } from '../../lib/share';

interface Props {
  piece: { slug: string; title: string; clipUrl: string };
  size?: 'sm';
}

const { piece, size } = Astro.props;
---

<div class:list={['clip-actions', size && 'clip-actions--sm']}>
  <a
    class="act"
    data-save-clip
    href={piece.clipUrl}
    download={`bach-bench-${piece.slug}.mp4`}
    aria-label={`Download ${piece.title}`}><Icon name="download" />Download</a
  >
  <button
    class="act"
    type="button"
    data-copy-address={pieceAddress(piece.slug)}
    aria-label={`Copy link to ${piece.title}`}
    ><span class="copy-icon"><Icon name="link" />Copy link</span><span
      class="copied-icon"><Icon name="check" />Copied</span
    ></button
  >
  <a
    class="act"
    href={`/p/${piece.slug}/analytics`}
    aria-label={`Stats for ${piece.title}`}><Icon name="analytics" />Stats</a
  >
  <span role="status" class="sr-only"></span>
</div>

<script>
  import '../../lib/clip-actions';
</script>

<style>
  .clip-actions {
    display: flex;
    flex-wrap: wrap;
    margin-left: -10px;
  }
  .act {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 10px;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    font: 500 14px/1 var(--font);
    letter-spacing: -0.006em;
    white-space: nowrap;
    color: var(--muted);
    cursor: pointer;
    transition: color 120ms ease, background-color 120ms ease;
  }
  .act:active {
    transform: scale(0.97);
  }
  .clip-actions--sm {
    margin-left: -8px;
  }
  .clip-actions--sm .act {
    height: 28px;
    padding: 0 8px;
    gap: 5px;
    font-size: 13px;
  }
  @media (hover: hover) and (pointer: fine) {
    .act:hover {
      color: var(--ink);
      background: var(--soft);
    }
  }
  button span {
    display: inline-flex;
    align-items: center;
    gap: inherit;
  }
  button:not([data-done]) .copied-icon,
  button[data-done] .copy-icon {
    display: none;
  }
</style>
