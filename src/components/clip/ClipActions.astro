---
import Icon from '../Icon.astro';
import { pieceAddress } from '../../lib/share';

interface Props {
  piece: { slug: string; title: string; clipUrl: string };
  size?: 'sm';
}

const { piece, size } = Astro.props;
---

<div class:list={['clip-actions', size && 'clip-actions--sm']}>
  <a
    class="act"
    data-save-clip
    href={piece.clipUrl}
    download={`bach-bench-${piece.slug}.mp4`}
    aria-label={`Download ${piece.title}`}><Icon name="download" />Download</a
  >
  <button
    class="act"
    type="button"
    data-copy-address={pieceAddress(piece.slug)}
    aria-label={`Copy link to ${piece.title}`}
    ><span class="copy-icon"><Icon name="link" />Copy link</span><span
      class="copied-icon"><Icon name="check" />Copied</span
    ></button
  >
  <a
    class="act"
    href={`/p/${piece.slug}/analytics`}
    aria-label={`Stats for ${piece.title}`}><Icon name="analytics" />Stats</a
  >
  <span role="status" class="sr-only"></span>
</div>

<script>
  const saving = new WeakSet<HTMLAnchorElement>();
  const resets = new WeakMap<HTMLButtonElement, ReturnType<typeof setTimeout>>();

  document.addEventListener('click', async (event) => {
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>('[data-save-clip]');
    const button = event.target.closest<HTMLButtonElement>('[data-copy-address]');
    if (link) {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      if (saving.has(link)) return;
      saving.add(link);
      const status = link.parentElement!.querySelector('[role="status"]')!;
      status.textContent = '';

      try {
        const response = await fetch(link.href);
        if (!response.ok) throw new Error('Clip unavailable');
        const file = new File([await response.blob()], link.download, { type: 'video/mp4' });
        if (navigator.canShare?.({ files: [file] })) {
          try {
            await navigator.share({ files: [file] });
            return;
          } catch (error) {
            if (error instanceof DOMException && error.name === 'AbortError') return;
          }
        }
        const url = URL.createObjectURL(file);
        const download = document.createElement('a');
        download.href = url;
        download.download = link.download;
        document.body.append(download);
        download.click();
        download.remove();
        setTimeout(() => URL.revokeObjectURL(url), 30_000);
      } catch {
        status.textContent = 'Could not download Clip';
      } finally {
        saving.delete(link);
      }
    }

    if (button) {
      const status = button.parentElement!.querySelector('[role="status"]')!;
      try {
        await navigator.clipboard.writeText(button.dataset.copyAddress!);
        button.dataset.copied = '';
        status.textContent = 'Link copied';
        clearTimeout(resets.get(button));
        resets.set(button, setTimeout(() => {
          delete button.dataset.copied;
          status.textContent = '';
        }, 2000));
      } catch {
        status.textContent = 'Could not copy link';
      }
    }
  });
</script>

<style>
  .clip-actions {
    display: flex;
    flex-wrap: wrap;
    margin-left: -10px;
  }
  .act {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 10px;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    font: 500 14px/1 var(--font);
    letter-spacing: -0.006em;
    white-space: nowrap;
    color: var(--muted);
    cursor: pointer;
    transition: color 120ms ease, background-color 120ms ease;
  }
  .act:active {
    transform: scale(0.97);
  }
  .clip-actions--sm {
    margin-left: -8px;
  }
  .clip-actions--sm .act {
    height: 28px;
    padding: 0 8px;
    gap: 5px;
    font-size: 13px;
  }
  @media (hover: hover) and (pointer: fine) {
    .act:hover {
      color: var(--ink);
      background: var(--soft);
    }
  }
  button span {
    display: inline-flex;
    align-items: center;
    gap: inherit;
  }
  button:not([data-copied]) .copied-icon,
  button[data-copied] .copy-icon {
    display: none;
  }
</style>
