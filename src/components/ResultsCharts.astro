---
import '../styles/charts.css';

const { set = 'results' } = Astro.props;
const { revision, titleWordCounts, pieces } = Astro.locals.vault;
const chartData = {
  revision,
  titleWordCounts,
  pieces: pieces.map(({ slug, title, modelName, lab, effort, map, measurements, scores, detailUrl }) => ({
    id: slug, title, model: modelName, lab, effort, map, ...scores,
    timeSeconds: measurements.wall, detailUrl,
  })),
};
---

{set === 'results' && <div class="chart-toolbar" id="toolbar" />}
<div class="charts" id="charts" data-set={set}></div>
<p id="chart-unavailable" hidden>Charts are temporarily unavailable.</p>
<script
  is:inline
  id="bach-data"
  type="application/json"
  set:html={JSON.stringify(chartData).replace(/</g, '\\u003c')}
/>
<script>
  const chart = document.querySelector<HTMLElement>('#charts')!;
  async function draw() {
    const { default: fonts } = await import('../styles/chart-fonts.css?raw');
    const style = document.createElement('style');
    style.id = 'fontfaces';
    style.textContent = fonts;
    document.head.append(style);
    await import('../lib/charts.mjs');
  }

  function start() {
    void draw().catch(() => {
      document.querySelector<HTMLElement>('#chart-unavailable')!.hidden = false;
    });
  }

  if (chart.dataset.set !== 'home' || location.hash.includes('chart=')) start();
  else {
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      observer.disconnect();
      start();
    }, { rootMargin: '100px 0px' });
    observer.observe(chart);
  }
</script>
