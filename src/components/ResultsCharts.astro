---
import '../styles/charts.css';
import { scoreMetrics } from '../lib/scores';
import { HOME_PLOT_HEIGHT, homeCaption } from '../lib/home-charts.mjs';

const { set = 'results' } = Astro.props;
// The home page draws these three; their cards hold the space until the charts arrive.
const homeCharts = scoreMetrics.slice(0, 3);
const { revision, titleWordCounts, pieces } = Astro.locals.vault;
const chartData = {
  revision,
  titleWordCounts,
  pieces: pieces.map(({ slug, title, modelName, lab, effort, map, measurements, scores, detailUrl }) => ({
    id: slug, title, model: modelName, lab, effort, map, ...scores,
    timeSeconds: measurements.wall, detailUrl,
  })),
};
---

{set === 'results' && <div class="chart-toolbar" id="toolbar" />}
<div class="charts" id="charts" data-set={set}>
  {set === 'home' && homeCharts.map(({ key, label }) => (
    <section class="cf cf-wait" aria-hidden="true" style={`--plot:${HOME_PLOT_HEIGHT}px`}>
      <div class="cf-head"><h2 class="cf-title">{label}</h2></div>
      <div class="cf-wait-plot"></div>
      <div class="cf-foot">
        <p class="cf-cap">{homeCaption(key, pieces.filter((piece) => piece.scores[key] != null).length)}</p>
      </div>
    </section>
  ))}
</div>
<p id="chart-unavailable" hidden>Charts are temporarily unavailable.</p>
<script
  is:inline
  id="bach-data"
  type="application/json"
  set:html={JSON.stringify(chartData).replace(/</g, '\\u003c')}
/>
<script>
  const chart = document.querySelector<HTMLElement>('#charts')!;
  // One download carries the chart code and the fonts it measures with.
  const draw = () => import('../lib/charts.mjs');

  function start() {
    void draw().catch(() => {
      document.querySelector<HTMLElement>('#chart-unavailable')!.hidden = false;
    });
  }

  if (chart.dataset.set !== 'home' || location.hash.includes('chart=')) start();
  else {
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      observer.disconnect();
      start();
    }, { rootMargin: '600px 0px' });
    observer.observe(chart);
  }
</script>
